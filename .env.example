# Nazwa DNS hosta w Twojej sieci (lub adres IP), pod którą aplikacja ma być
# dostępna. NIE wymaga publicznej domeny ani rejestracji — sprawdź własną
# poleceniem `hostname -f` (lub użyj wpisu z lokalnego/firmowego DNS albo
# po prostu adresu IP serwera, jeśli nie masz lokalnego DNS).
HOST=host.example.lan

# Porty na hoście. Rootless Podman nie może bindować portów <1024, dlatego
# domyślnie 8080/8443 — aplikacja jest wtedy pod https://$HOST:$HTTPS_PORT.
# Jeśli uruchamiasz jako root albo obniżysz net.ipv4.ip_unprivileged_port_start,
# możesz ustawić 80/443 i mieć adres bez numeru portu.
# Adres publikacji portów. 127.0.0.1 = aplikacja wystawiona wyłącznie przez
# Tailscale (`tailscale serve`), nieosiągalna z sieci niezależnie od zapory.
# 0.0.0.0 = dostęp wprost z sieci pod https://$HOST:$HTTPS_PORT.
BIND_ADDR=127.0.0.1

HTTP_PORT=8080
HTTPS_PORT=8443

DB_USER=tracker
DB_PASSWORD=zmien_to_na_silne_haslo
DB_NAME=tracker
